# Environment Configuration
DATABASE_URL="file:./dev.db"
NODE_ENV="development"

# Security & Sessions
JWT_SECRET="your_jwt_session_signing_secret"
SESSION_EXPIRY_HOURS="72"

# Internal Worker Authentication (M2M authentication for Python LiveKit Agent)
WORKER_API_SECRET="your_worker_api_secret_key"

# LiveKit Realtime Voice Boundary (Server-side ONLY, never exposed to browser)
LIVEKIT_URL="wss://your-livekit-server.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"

# Telephony & External Providers
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
OPENAI_API_KEY=""
CARTESIA_API_KEY=""
ELEVENLABS_API_KEY=""

# Phase 4 Telephony & LiveKit SIP Configuration (India / Mumbai ap-south)
# Provider 1: Plivo Zentrunk India
# IMPORTANT: Plivo account must be created with Data Region = 'India'
PLIVO_AUTH_ID="REQUIRED_EXTERNAL_CONFIGURATION"
PLIVO_AUTH_TOKEN="REQUIRED_EXTERNAL_CONFIGURATION"
PLIVO_DATA_REGION="India"

# LiveKit India SIP FQDN (Pinned to ap-south Mumbai)
# Note: Format must match {subdomain}.india.sip.livekit.cloud to satisfy TRAI media anchoring
LIVEKIT_SIP_URI="{subdomain}.india.sip.livekit.cloud"
LIVEKIT_SIP_TRUNK_ID="REQUIRED_EXTERNAL_CONFIGURATION"
SIP_PROVIDER_NAME="Plivo" # Options: Plivo, Exotel, Telnyx, Twilio
SIP_SIMULATION_MODE="true" # Set to 'false' only after real Plivo DID + Zentrunk are provisioned
